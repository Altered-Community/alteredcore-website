<IfModule mod_rewrite.c>
    RewriteEngine On

    # Skip real files and real directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route all /pages/{slug} through the central router (core + plugin pages)
    RewriteRule ^pages/([a-z0-9_-]+)/?$ pages/_router.php [QSA,L]

    # Deep links inside SPA plugin pages: /pages/{slug}/{rest…}. The router serves
    # them only for pages declared "type": "spa" (client-side routing) and 404s the rest.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^pages/([a-z0-9_-]+)/(.+)$ pages/_router.php [QSA,L]

    # Authenticated service relay for front-end plugins: /api/v1/services/{service}/{path}
    RewriteRule ^api/v1/services/([a-z0-9-]+)/(.*)$ api/v1/services/proxy.php?_service=$1&_path=$2 [B,QSA,L]

    # Plugin API endpoints: /papi/{plugin-id}/{endpoint}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^papi/([a-z0-9_-]+)/([a-z0-9_-]+)/?$ includes/_plugin_router.php?_plugin=$1&_endpoint=$2 [QSA,L]

    # All other extensionless URLs get .php appended directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^.]+?)/?$ $1.php [L]
</IfModule>

# ErrorDocument 404 /pages/404.php