{
    "$schema":      "../plugin.schema.json",
    "id":           "ownership",
    "name":         "Digital Ownership",
    "version":      "1.0.0",
    "description":  "Opening digital boosters and viewing the ownership transaction history, backed by the AlteredOwnership service.",
    "author":       "AlteredCore",
    "icon":         "fa-solid fa-gift",

    "pages": [
        {"slug": "ownership",            "file": "pages/ownership.php",  "title_en": "Digital Ownership", "title_fr": "Propriété numérique"},
        {"slug": "ownership-collection", "file": "pages/collection.php", "title_en": "Collection",        "title_fr": "Collection"},
        {"slug": "boosters",             "file": "pages/boosters.php",   "title_en": "Boosters",          "title_fr": "Boosters"},
        {"slug": "ownership-history",    "file": "pages/history.php",    "title_en": "History",           "title_fr": "Historique"},
        {"slug": "ownership-alt-arts",   "file": "pages/alt-arts.php",   "title_en": "Alt Arts BGA",       "title_fr": "Alt Arts BGA"}
    ],

    "api": [
        {"endpoint": "boosters-list",       "file": "api/boosters-list.php"},
        {"endpoint": "boosters-open",       "file": "api/boosters-open.php"},
        {"endpoint": "history-list",        "file": "api/history-list.php"},
        {"endpoint": "history-detail",      "file": "api/history-detail.php"},
        {"endpoint": "alt-art-search",      "file": "api/alt-art-search.php"},
        {"endpoint": "alt-art-set-preference", "file": "api/alt-art-set-preference.php"}
    ],

    "assets": {
        "css": ["assets/style.css"],
        "js":  ["js/card-tilt.js", "js/boosters.js", "js/history.js", "js/alt-arts.js", "js/alt-art-widget.js", "js/card-modal-enhance.js"]
    }
}
