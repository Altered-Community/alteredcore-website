{
    "$schema":          "../plugin.schema.json",
    "manifest_version": 2,
    "id":               "rebuilder",
    "name":             "Re:Builder",
    "version":          "0.2.0",
    "description":      "Deck list, deck page and deck editor of Altered Re:Builder (Angular), mounted as a SPA page on /pages/rebuilder, next to the site's own decks pages and deck builder.",
    "author":           "Yutsa",
    "icon":             "fa-solid fa-pen-ruler",

    "pages": [
        {
            "slug":     "rebuilder",
            "type":     "spa",
            "entry":    "dist/embed-manifest.json",
            "mount":    "shadow",
            "fullwidth": false,
            "title_en": "Re:Builder",
            "title_fr": "Re:Builder"
        }
    ],

    "menu": [
        {
            "label_en": "Re:Builder", "label_fr": "Re:Builder", "icon": "fa-solid fa-pen-ruler", "sort_order": 35,
            "children": [
                { "page": "rebuilder", "path": "decks",     "label_en": "Decks",        "label_fr": "Decks",            "icon": "fa-solid fa-layer-group" },
                { "page": "rebuilder", "path": "decks/new", "label_en": "Deck Builder", "label_fr": "Créateur de deck", "icon": "fa-solid fa-pen-ruler" }
            ]
        }
    ],

    "build": {
        "workdir": "app",
        "install": "npm ci --no-audit --no-fund",
        "lint":    "npm run lint",
        "test":    "npm test",
        "build":   "npm run build:embed",
        "output":  "dist"
    },

    "tests": {
        "e2e": "e2e"
    }
}
