# Build files with a content hash in their name (dist/browser: main-HASH.js, polyfills-HASH.js, chunk-HASH.js,
# media/NAME-HASH.woff2): a new build has new names, so browsers keep them without asking again.
<IfModule mod_headers.c>
    <FilesMatch "^((main|polyfills|chunk)-[A-Za-z0-9_-]{8,}\.js|[A-Za-z0-9_-]+-[A-Z0-9]{8}\.woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
