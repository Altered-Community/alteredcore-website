#!/usr/bin/env bash
# verify-deckbuilder — doctor / launch / drive / cleanup for the production deckbuilder.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
HELPER="$SKILL_DIR/helpers/playwright-drive.mjs"
SITE="${VERIFY_SITE_URL:-http://localhost:18181}"
CARDS_API="${VERIFY_CARDS_API:-https://cards.alteredcore.org/api/cards?itemsPerPage=1}"
AUTH="${VERIFY_AUTH_URL:-http://auth.altered.local.gd:18080}"
DECKS_API="${VERIFY_DECKS_API:-http://localhost:8001}"
EVIDENCE_DEFAULT="/cursor/stores/bc-75040492-8fc0-4c5d-b162-04dfa8f083d2/media"
ALTERED_ROOT="${ALTERED_ROOT:-/home/ubuntu/altered}"
VERIFY_RUN_ID="${VERIFY_RUN_ID:-$$-$(date +%s)}"
export VERIFY_RUN_ID

usage() {
  cat <<EOF
Usage: $(basename "$0") <doctor|launch|drive|cleanup> [feature-id] [--evidence DIR] [--user NAME]

  doctor    Read-only: website, cards API, Keycloak
  launch    Wait until the website answers; print cloud-start.sh if not
  drive     Playwright one mapped feature (see features/)
  cleanup   Remove /tmp/verify-deckbuilder-\$VERIFY_RUN_ID (not evidence, not Aspire)
EOF
}

http_code() {
  curl -sS -o /dev/null -w "%{http_code}" --max-time 20 "$1" || echo "000"
}

cmd_doctor() {
  local ok=0
  local code body
  code="$(http_code "$SITE/pages/deckbuilder")"
  echo "website $SITE/pages/deckbuilder → HTTP $code"
  if [[ "$code" != "200" ]]; then
    echo "FAIL: website not ready" >&2
    ok=1
  else
    body="$(curl -sS --max-time 30 "$SITE/pages/deckbuilder" || true)"
    if ! grep -q 'id="db-new-modal"' <<<"$body" || ! grep -q 'id="db-search"' <<<"$body" || ! grep -q 'AlteredDB' <<<"$body"; then
      echo "FAIL: page is not production core-altered-cards deckbuilder (missing db-new-modal / db-search / AlteredDB)" >&2
      ok=1
    else
      echo "ok: production markers (db-new-modal, db-search, AlteredDB)"
    fi
    if grep -qi 'altered-deckbuilder-poc' <<<"$body"; then
      echo "FAIL: POC markup detected" >&2
      ok=1
    fi
  fi

  code="$(http_code "$CARDS_API")"
  echo "cards API $CARDS_API → HTTP $code"
  [[ "$code" == "200" ]] || { echo "FAIL: cards API" >&2; ok=1; }

  code="$(http_code "$AUTH/")"
  echo "keycloak $AUTH → HTTP $code"
  if [[ "$code" != "200" && "$code" != "302" ]]; then
    echo "FAIL: Keycloak" >&2
    ok=1
  fi

  code="$(http_code "$DECKS_API/")"
  echo "decks API $DECKS_API → HTTP $code (informational)"

  return "$ok"
}

cmd_launch() {
  local i
  if [[ "$(http_code "$SITE/pages/deckbuilder")" == "200" ]]; then
    echo "ready: $SITE"
    cmd_doctor
    return
  fi
  echo "website down. Start the shared stack with:"
  echo "  $ALTERED_ROOT/scripts/cloud-start.sh"
  echo "Waiting up to 180s for $SITE ..."
  for i in $(seq 1 60); do
    if [[ "$(http_code "$SITE/pages/deckbuilder")" == "200" ]]; then
      echo "ready after ${i}s*3"
      cmd_doctor
      return
    fi
    sleep 3
  done
  echo "FAIL: still down after wait. Do not start a second Aspire if one is already running." >&2
  return 1
}

cmd_drive() {
  local feature="${1:-}"
  shift || true
  local evidence="$EVIDENCE_DEFAULT"
  local user="alice"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --evidence) evidence="${2:-}"; shift 2 ;;
      --user) user="${2:-}"; shift 2 ;;
      *) echo "unknown arg: $1" >&2; return 2 ;;
    esac
  done
  if [[ -z "$feature" ]]; then
    echo "drive requires a feature id (create-deck, search-add-cards, save-deck, browse-decks, view-stats-hand)" >&2
    return 2
  fi
  cmd_doctor
  mkdir -p "$evidence"
  export VERIFY_SITE_URL="$SITE"
  export VERIFY_EVIDENCE_DIR="$evidence"
  export VERIFY_USER="$user"
  export VERIFY_PASSWORD="${VERIFY_PASSWORD:-TestPassword1234}"
  export VERIFY_FEATURE="$feature"
  export VERIFY_PROFILE="/tmp/verify-deckbuilder-$VERIFY_RUN_ID"
  mkdir -p "$VERIFY_PROFILE"
  (
    cd "$(dirname "$HELPER")"
    if [[ ! -d node_modules/playwright ]]; then
      npm install --omit=dev >/tmp/verify-deckbuilder-npm.log 2>&1 || {
        echo "FAIL: npm install playwright (see /tmp/verify-deckbuilder-npm.log)" >&2
        return 1
      }
    fi
    npx playwright install chromium >/tmp/verify-deckbuilder-playwright-install.log 2>&1 || {
      echo "WARN: playwright install chromium failed; see /tmp/verify-deckbuilder-playwright-install.log" >&2
    }
  )
  node "$HELPER"
}

cmd_cleanup() {
  local dir="/tmp/verify-deckbuilder-$VERIFY_RUN_ID"
  if [[ "${VERIFY_CLEAN_ALL_PROFILES:-}" == "1" ]]; then
    shopt -s nullglob
    for dir in /tmp/verify-deckbuilder-*; do
      [[ -d "$dir" ]] || continue
      rm -rf "$dir"
      echo "removed $dir"
    done
    return 0
  fi
  if [[ -d "$dir" ]]; then
    rm -rf "$dir"
    echo "removed $dir"
  else
    echo "no profile $dir"
  fi
  echo "evidence left in ${VERIFY_EVIDENCE_DIR:-$EVIDENCE_DEFAULT}"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    doctor) cmd_doctor ;;
    launch) cmd_launch ;;
    drive) cmd_drive "$@" ;;
    cleanup) cmd_cleanup ;;
    -h|--help|help|"") usage; [[ -n "$cmd" ]] ;;
    *) echo "unknown command: $cmd" >&2; usage; return 2 ;;
  esac
}

main "$@"
